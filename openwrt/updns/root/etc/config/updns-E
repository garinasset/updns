config updns 'general'
	option enabled '0'
	option port '153'
	option use_local_resolv '1'
	option local_resolv_file '/tmp/resolv.conf.d/resolv.conf.auto'
	option concurrent_query '0'
	option cache_enabled '1'
	option cache_size '4096'
	option active_preload '1'
	option log_query '0'
	option log_level 'info'

config upstream 'tencent_udp'
	option name 'Tencent-UDP'
	option address '119.29.29.29'
	option protocol 'udp'
	option timeout '5'

config upstream 'google_doh'
	option name 'Google-DoH'
	option address 'https://dns.google/dns-query'
	option protocol 'doh'
	option timeout '5'

config upstream 'cloudflare_doh'
	option name 'Cloudflare-DoH'
	option address 'https://one.one.one.one/dns-query'
	option protocol 'doh'
	option timeout '5'

config upstream 'tencent_doh'
	option name 'Tencent-DoH'
	option address 'https://doh.pub/dns-query'
	option protocol 'doh'
	option timeout '5'

config upstream 'adguard_doh'
	option name 'AdGuard-DoH'
	option address 'https://unfiltered.adguard-dns.com/dns-query'
	option protocol 'doh'
	option timeout '5'
