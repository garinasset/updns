#!/bin/sh /etc/rc.common

START=80
STOP=10
USE_PROCD=1

PROG=/usr/bin/updns
CONFIG=updns
CONFIG_FILE=/etc/config/updns

. /lib/functions.sh

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}

clear_service_state() {
	"$PROG" -c "$CONFIG_FILE" -action clear
}

start_service() {
	local enabled
	config_load "$CONFIG"
	config_get_bool enabled general enabled 0

	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONFIG_FILE" -action start
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 3
	procd_close_instance
}

reload_service() {
	local enabled
	config_load "$CONFIG"
	config_get_bool enabled general enabled 0

	if [ "$enabled" = "1" ]; then
		/etc/init.d/updns enable || return 1
		restart
	else
		stop || return 1
		/etc/init.d/updns disable
	fi
}

restart() {
	if ! clear_service_state; then
		logger -t updns -p daemon.warning "Could not clear previous nftset state; continuing with service restart"
	fi
	stop
	start
}

stop_service() {
	:
}
